# Copy to config.env in this folder to change the defaults. No secrets go here: the registration
# key is generated by install.sh into $FZH_ROOT/data/registration-key.txt.

# Root of the installation: bin/ (shadNet), app/ (Python services), data/, logs/, run/ (pid files).
FZH_ROOT="$HOME/fzh"
# Python 3.9 or newer, standard library only.
PYTHON=python3
# Address the backend and the relay listen on (shadNet listens on all interfaces).
BIND_HOST=0.0.0.0
# shadNet binary protocol, TCP. Players with non-standard ports enter
# host:game:matching:webapi:backend:relay in the launcher.
GAME_PORT=31313
# shadNet matching (STUN), UDP.
MATCHING_PORT=31314
# shadNet WebAPI, TCP.
WEBAPI_PORT=31315
# Progression backend, TCP.
BACKEND_PORT=1338
# P2P relay, UDP.
RELAY_PORT=31316

# Backend settings (docs/self-hosting.md, "Accounts and players"). Empty = the default shown.
# grant: the game's login works only for an account the launcher vouched for from the same
# address (POST /account/v1/play); open: any login, for launchers without that step.
FZH_GAME_LOGIN=grant
# Lifetime of a play grant and of a game session, in hours.
FZH_SESSION_HOURS=12
# Accounts one address may register per 24 hours, seconds between two of them, and accounts
# registered per hour from all addresses together.
FZH_REGISTER_PER_DAY=3
FZH_REGISTER_COOLDOWN=60
FZH_REGISTER_GLOBAL_PER_HOUR=30
# Online IDs refused in addition to the built-in list, comma-separated.
FZH_RESERVED_NAMES=
# Behind a reverse proxy only: the header it sets with the client address (e.g. X-Forwarded-For)
# and the addresses the proxy connects from. Without a proxy leave both empty: anyone could set
# the header.
FZH_TRUSTED_PROXY_HEADER=
FZH_TRUSTED_PROXIES=127.0.0.1,::1
