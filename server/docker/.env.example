# Copy to .env next to docker-compose.yml to change the defaults.

# Host folder for everything that must survive (shadNet database, progression, registration key).
FZH_DATA=/srv/fzh
# Prefix of the container and image names.
COMPOSE_PROJECT_NAME=fzh

# Backend settings (docs/self-hosting.md, "Accounts and players"). Empty = the default shown.
# grant: the game's login works only for an account the launcher vouched for from the same
# address (POST /account/v1/play); open: any login, for launchers without that step.
FZH_GAME_LOGIN=grant
# Lifetime of a play grant and of a game session, in hours.
FZH_SESSION_HOURS=12
# Accounts one address may register per 24 hours, seconds between two of them, and accounts
# registered per hour from all addresses together.
FZH_REGISTER_PER_DAY=3
FZH_REGISTER_COOLDOWN=60
FZH_REGISTER_GLOBAL_PER_HOUR=30
# Online IDs refused in addition to the built-in list, comma-separated.
FZH_RESERVED_NAMES=
# Behind a reverse proxy only: the header it sets with the client address (e.g. X-Forwarded-For)
# and the addresses the backend sees the proxy connect from (with Docker, the compose network's
# gateway, e.g. 172.18.0.1). Without a proxy leave both empty: anyone could set the header.
FZH_TRUSTED_PROXY_HEADER=
FZH_TRUSTED_PROXIES=127.0.0.1,::1
# Off when empty. Your own list of relays (the format of server/relay/relays.json) as the
# backend container sees it: put the file in $FZH_DATA/backend and name it /data/<file>, e.g.
# /data/relays.json. The backend asks each relay once a minute whether it answers and gives
# launchers the list with the result (docs/self-hosting.md, "Relay status").
FZH_RELAY_LIST=
