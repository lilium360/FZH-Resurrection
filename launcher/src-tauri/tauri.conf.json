{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FZH Resurrection",
  "version": "0.2.1",
  "identifier": "com.fzh-resurrection.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/bundle-emulator.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FZH:Resurrection",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": true,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "FZH:Resurrection launcher",
    "longDescription": "Launcher for Firewall Zero Hour in PC VR through a shadPS4 fork. No game files are included.",
    "resources": {
      "../../patches/*.xml": "patches/",
      "../../tools/input/warmup.txt": "input/warmup.txt",
      "bundle/emulator/": "emulator/",
      "bundle/licences/": "licences/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5N0I2OEYwMDdGN0JEMjUKUldRbHZmY0g4R2g3U2Uxejh0bzdmTy9jeUcrM3hONVhERnNzRVNPQTdnZko1b1NDRVdjY0xGQjAK",
      "endpoints": ["https://github.com/lilium360/FZH-Resurrection/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
